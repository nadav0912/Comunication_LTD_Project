# Comunication_LTD — VULNERABLE build environment (SPEC.md §4).
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Differs from the secure tree ONLY in PORT and DB_NAME (SPEC §5 "Where the two trees differ").

# --- server ---
PORT=3001
# 32+ random bytes as hex, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=replace-with-32-plus-random-hex-bytes

# --- database (AWS RDS MySQL 8.x, TLS required) — SEPARATE schema from secure (SPEC §3) ---
DB_HOST=your-instance.your-region.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=replace-with-rds-password
DB_NAME=vulnerable_app_db
DB_SSL=true

# --- mail (Gmail SMTP with a 16-char app password, NOT the account password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=replace-with-16-char-google-app-password
MAIL_FROM=Comunication_LTD <you@gmail.com>

# --- password reset ---
RESET_TOKEN_TTL_MINUTES=15
